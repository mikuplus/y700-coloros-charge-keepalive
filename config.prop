# Y700 充电保活 + 温控阶梯 —— 可调参数
# 改完保存即可，约 3 秒内自动生效，无需重启。
#
# 单位说明：
#   TEMP_*      电池温度，0.1℃              （390 = 39.0℃）
#   QUIET_*     quiet-therm 板级温度，0.001℃（44000 = 44.0℃）
#   MAX_CURRENT 目标最大充电电流，mA          （6000000 = 6.0A）
#   CE_TEMP_MAX 超过此温度就不再强制开充电

# 总开关：1=启用  0=关闭
ENABLE_CE=1
ENABLE_THERMAL=1

# 强制开充电的上限（温度 / 电量）
CE_TEMP_MAX=450
CAP_MAX=100

# 目标最大充电电流（mA）
#   6000000   = 6.0A
#   6200000   = 6.2A
#   7000000   = 7.0A
#   4000000   = 4.0A
# 说明：硬件是离散档位（13A/12.5/11.5/10.5/9.5/8.5/7/6/5/4/3/2.5/2/1.5/0.5A），
#       模块会选「不低于目标值的最小档位」，实际电流再由充电器与 PD 协商决定。
MAX_CURRENT=6000000

# 温控阶梯 —— 电池温度条件
TEMP_6A=390
TEMP_4A=410
TEMP_3A=430

# 温控阶梯 —— quiet-therm 板级温度条件（更保守，防止充电 IC 过热）
QUIET_6A=44000
QUIET_4A=45000
QUIET_3A=46000

# ============ 电量分档限流（涓流充电）============
ENABLE_SOC_GUARD=1
SOC_80=80
SOC_90=90
SOC_95=95
SOC_A_80=5000000        # 80~89%   上限 5A  ≈ 0.66C  ~47W
SOC_A_90=3000000        # 90~94%   上限 3A  ≈ 0.39C  ~28W
SOC_A_95=1500000        # >=95%    上限 1.5A ≈ 0.2C  ~14W
# 想更快就把 SOC_A_90 调回 5000000、SOC_A_95 调到 3000000。
# 想更保守就把它们往下压，例如 SOC_A_80=4000000、SOC_A_90=2000000。

# ============ 轮询参数============
# 充电时多少秒轮询一次（支持小数）。
# 默认 0.3；调大更省电但 charging_enable 被打回后恢复更慢，建议 0.2 ~ 1.0。
CHARGE_POLL=0.3

# 没在充电时多少秒自查一次。
# 本机 inotify 不产生事件、logcat 管道有缓冲，做不了零轮询，用长间隔代替。
# 调大更省电（插电后恢复更慢），调小恢复更快。5 秒时插电最多 5 秒开始保活。
IDLE_POLL=5

# 连续多少次（按 CHARGE_POLL 计）检测到放电才停止轮询。
# 默认 20，配 0.3 秒时约 6 秒。防止充电刚建立时被误判。
IDLE_NEED=20

# ============ 电芯数 ============
# 内核上报的 voltage_now 是单芯电压。Y700 四代是 2S 串联双电芯，
# 整包电压要 ×2，不乘的话会话统计里的平均功率会少算一半。
#   2 = 串联双芯（默认）
#   1 = 单芯
CELLS=2

# ============ 档位标定============
# 首次插电时扫一遍冷却档位，记录每档对应的真实限流，约 2 秒（期间电流会抖一下）。
# 结果存 modules/charge_keepalive_fix/cdev_map.cache，之后直接复用。
# 想重新标定：删掉那个文件再重启模块。
ENABLE_CALIBRATE=1
